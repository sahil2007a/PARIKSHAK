# ==============================================================================
# PARIKSHAK (.gitignore)
# Prevents secrets, node_modules, build artifacts, and OS files from being committed
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
!.env.example
**/backend/.env
**/backend/.env.*
!**/backend/.env.example
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# Python Virtual Environments & Caches
# ------------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Expo & React Native Build Outputs
# ------------------------------------------------------------------------------
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
web-build/
android/app/build/
android/app/src/main/assets/index.android.bundle
ios/build/

# ------------------------------------------------------------------------------
# Build & Distribution Artifacts
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
.next/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Test Coverage & Diagnostics
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
tmp/
**/tmp/
temp/
**/temp/
.temp/
**/.temp/
.cache/
**/.cache/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
