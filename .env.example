# PARISHAK Environment Configuration

# Server
PORT=5000
NODE_ENV=development
APP_NAME=PARISHAK
API_PREFIX=/api

# Database (MongoDB Atlas URI or Memory DB fallback)
MONGODB_URI=mongodb+srv://admin:parishak_secret@cluster0.mongodb.net/parishak?retryWrites=true&w=majority&appName=ParishakCluster
USE_IN_MEMORY_DB_FALLBACK=true

# Security & JWT
JWT_ACCESS_SECRET=parishak_jwt_access_super_secret_key_2026_industrial_safety_shield
JWT_REFRESH_SECRET=parishak_jwt_refresh_super_secret_key_2026_refresh_token_protection
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Verification Base URL
CERTIFICATE_BASE_URL=https://verify.parishak.safety/cert

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,exp://localhost:8081,exp://*

# ML Model YOLO Service
ML_SERVICE_URL=http://localhost:8000
